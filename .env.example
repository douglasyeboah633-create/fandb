# ---------------------------------------------------------------------------
# LandPro Records Management System - environment configuration
# Copy this file to `.env` and adjust the values for your environment.
# ---------------------------------------------------------------------------

# Django core
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Africa/Accra

# Database
# Leave empty to use SQLite (recommended for development).
# Use a PostgreSQL URL in production, e.g.
# DATABASE_URL=postgres://user:password@host:5432/landpro
DATABASE_URL=

# Production security
DJANGO_SECURE_SSL_REDIRECT=True

# Business / branding (used on the UI, receipts and reports)
BUSINESS_NAME=LandPro Records Management System
BUSINESS_SHORT_NAME=LandPro
BUSINESS_TAGLINE=Land Sales Records Management
BUSINESS_PHONE=+233 00 000 0000
BUSINESS_EMAIL=info@landpro.example
BUSINESS_ADDRESS=Accra, Ghana
CURRENCY_SYMBOL=GHS